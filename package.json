{
  "name": "superseriousbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "bun run typecheck && bun test",
    "dev": "bun --watch src/main.ts",
    "operator": "bun src/operator.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "test:e2e": "bun tests/e2e/run.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "7.0.89",
    "chrono-node": "2.10.1",
    "cron-parser": "5.10.0",
    "effect": "4.0.0-rc.112",
    "fast-xml-parser": "5.11.1",
    "sharp": "0.35.4",
    "telegramify-markdown": "1.3.3",
    "telly": "file:vendor/telly-0.0.0.tgz"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "7.0.2"
  }
}
